# Required: the single shared password that gates the whole instance.
SKETCHSPACE_PASSWORD=change-me

# Recommended: stable secret for signing session cookies.
# If unset, a random one is generated at boot and everyone is logged out on restart.
SKETCHSPACE_SESSION_SECRET=

# Optional
PORT=3000
SKETCHSPACE_DATA_DIR=./data

# Optional: a Python with ifcopenshell (pip install ifcopenshell), used to fill
# view-titles and titleblocks with values from the model. Defaults to "python";
# without one they show their raw {{placeholders}}.
# SKETCHSPACE_PYTHON=python
