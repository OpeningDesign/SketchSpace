{
  "name": "sketchspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted collaborative multi-page whiteboard built on @excalidraw/excalidraw",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "sync:editor": "node scripts/sync-editor.mjs",
    "prebuild": "node scripts/check-vendor.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "import:layout": "node --env-file-if-exists=.env scripts/import-layout.mjs",
    "export:layout": "node --env-file-if-exists=.env scripts/export-layout.mjs",
    "backfill:layout": "node --env-file-if-exists=.env scripts/backfill-layout-meta.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@excalidraw/laser-pointer": "1.3.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@excalidraw/random-username": "1.1.0",
    "@lezer/highlight": "^1.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "browser-fs-access": "0.38.0",
    "canvas-roundrect-polyfill": "0.0.1",
    "clsx": "1.1.1",
    "concurrently": "^9.1.0",
    "es6-promise-pool": "2.5.0",
    "fuzzy": "0.1.3",
    "image-blob-reduce": "3.0.1",
    "jotai": "2.11.0",
    "jotai-scope": "0.7.2",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "pako": "2.0.3",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "1.0.1",
    "pwacompat": "2.0.17",
    "radix-ui": "1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "4.6.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "tunnel-rat": "0.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
